# Sistema operativo / editor
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
.claude/
# Ficheros scratch de sesiones del editor/agente (no forman parte del repo)
.tmp*
# Scripts de exploración / ingest / one-off del mantenedor
# (no son tests, no son CI; el README en scripts/ingest/README.md
#  explica qué hay en cada subdirectorio).
scripts/ingest/
# Notas/workspace personal del mantenedor (otros productos, .code-workspace local)
,dev/

# Por si en el futuro alguien añade alguna herramienta con dependencias
node_modules/
npm-debug.log*

# Artefactos de agentes/herramientas de IA (se regeneran localmente; no versionar)
graphify-out/
.graphifyignore

# Corpus/listas descargados por los scripts de mantenimiento y de
# sourcing (search-pictogram.js, es_list_clean.js, etc.) — contenido
# descargado de fuentes externas (Kaikki, listas de frecuencia, CEFRLex,
# nombres propios...), no una caché HTTP efímera; de ahí el nombre.
scripts/download/
scripts/ingest/download/
# Dependencias locales de scripts de la pipeline (msgpackr, etc.); se
# reinstalan con `npm install` al ejecutar el script si faltan.
scripts/ingest/pipeline/node_modules_root/

# Corpus de palabras fuente en formato borrador (no es contenido publicado;
# el diccionario vive en js/data.<lang>.js).
dev/corpus/

# Parches generados localmente (git format-patch, diffs de una sesión, etc.)
*.patch
# Logs de servidores de desarrollo locales (p.ej. scripts/.scratch/serve.js).
*.log

# Nunca subir el shared secret de OpenSymbols (se pasa como variable de entorno)
.env
.env.*

# Playwright run output (failure screenshots, traces, .last-run.json)
test-results/
playwright-report/

# Sondas y capturas de diagnostico de sesiones de mantenimiento.
# No son tests ni herramientas de la suite: se regeneran y se tiran.
_diag*.cjs
probe-*.mjs
shot-*.png
contrast-check.mjs
discover-pages.mjs
