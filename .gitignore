# Sistema operativo / editor
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
# Ficheros scratch de sesiones del editor/agente (no forman parte del repo)
.tmp*
# Scripts de exploración one-off del mantenedor (no son tests, no son CI)
scripts/.scratch/
# Notas/workspace personal del mantenedor (otros productos, .code-workspace local)
,dev/

# Por si en el futuro alguien añade alguna herramienta con dependencias
node_modules/
npm-debug.log*

# Artefactos de agentes/herramientas de IA (se regeneran localmente; no versionar)
graphify-out/
.graphifyignore

# Cachés que generan los scripts de mantenimiento (buscar-pictograma.js, etc.)
scripts/.cache/

# Nunca subir el shared secret de OpenSymbols (se pasa como variable de entorno)
.env
.env.*
