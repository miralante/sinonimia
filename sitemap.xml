<?xml version="1.0" encoding="UTF-8"?>
<!--
  sitemap.xml — generated by hand. Sinonimia has no build step, so we
  maintain this file on each meaningful content change. The dictionary
  routes (`#/palabra/...`) are hash-based and are not exposed to crawlers
  separately, so we list only the document roots that crawlers can fetch.

  To regenerate after adding a new translateable page, append a <url>
  with an <xhtml:link> for each alternate language when you add that
  language.

  Update the <lastmod> with the date of the deploy that introduced the
  page; the current date is the deploy date.
-->
<urlset
  xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <url>
    <loc>https://sinonimia.pages.dev/</loc>
    <xhtml:link rel="alternate" hreflang="es" href="https://sinonimia.pages.dev/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://sinonimia.pages.dev/?lang=en"/>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://sinonimia.pages.dev/about/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://sinonimia.pages.dev/about/privacidad.html</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
